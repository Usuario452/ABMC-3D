{
  "name": "kubostudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/brand-assets.mts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "db:migrate:prod": "node --env-file=.env.vercel.local scripts/db-migrate.mts",
    "db:seed:dev": "node --env-file-if-exists=.env.local scripts/db-seed-dev.mts",
    "db:create-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/create-admin.mts",
    "db:create-admin:prod": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.vercel.local scripts/create-admin.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "next": "16.4.3",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
