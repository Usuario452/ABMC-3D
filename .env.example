# KuboStudio — variáveis de ambiente
# Copie para .env.local e preencha com os valores do seu projeto.
# Valores abaixo são apenas ilustrativos.

# PostgreSQL (somente no servidor — nunca use o prefixo NEXT_PUBLIC_).
# Local: npm run db:up sobe o Postgres do docker-compose.yml.
# Produção (Vercel/serverless): use a URL do pooler em modo transaction (ex.: porta 6543 no Supabase).
DATABASE_URL=postgresql://kubo:kubo@127.0.0.1:5433/kubostudio

# WhatsApp que recebe os pedidos: somente números, com DDI 55 + DDD + número.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# URL pública do site (SEO, sitemap e links de compartilhamento). Opcional em desenvolvimento.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Imagens dos produtos — Cloudflare R2 (API compatível com S3).
# URL pública do bucket: domínio próprio (recomendado em produção) ou https://pub-xxxx.r2.dev para testes.
NEXT_PUBLIC_IMAGES_BASE_URL=https://img.seudominio.com.br
# Somente no servidor (sem NEXT_PUBLIC_). Token "Object Read & Write" restrito ao bucket.
R2_ACCOUNT_ID=seu_account_id
R2_BUCKET=kubostudio-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
